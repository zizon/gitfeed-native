{
  "name": "@zizon/gitfeed-native",
  "version": "3.6.1",
  "type": "module",
  "description": "Git-backed RSS reader as a native DeepSeek Harness bundle: reader page, adaptive refresh and read-state schedule, git sync, and an agent tool. The package is code only; the data lives in a separate gitfeed data repository.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zizon/gitfeed-native.git"
  },
  "license": "MIT",
  "author": "zizon",
  "homepage": "https://github.com/zizon/gitfeed-native#readme",
  "bugs": {
    "url": "https://github.com/zizon/gitfeed-native/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "rss",
    "feed-reader",
    "git",
    "plugin",
    "bundle"
  ],
  "engines": {
    "node": ">=24.9.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "bin/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/screenshots/",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "scripts": {
    "prepare": "node build.mjs",
    "build": "node build.mjs",
    "typecheck": "node build.mjs --typecheck-only",
    "pretest": "node build.mjs",
    "test": "node tests/run.mjs",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix && oxlint src --fix"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-store": "0.1.2-alpha.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "esbuild": "0.28.2",
    "eslint-plugin-sonarjs": "^4.2.2",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "6.0.3"
  },
  "bin": {
    "gitfeed": "bin/gitfeed.mjs"
  }
}
